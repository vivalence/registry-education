{
  "manifest": {
    "type": "instance",
    "slug": "spanish",
    "version": "0.0.1"
  },
  "hallucinators": [
    {
      "module": "@commons/hallucinator/anthropic",
      "secrets": {
        "key": "${SECRET_VIVA_ANTHROPIC_API_KEY}"
      }
    },
    {
      "module": "@commons/hallucinator/elevenlabs",
      "secrets": {
        "key": "${SECRET_VIVA_ELEVENLABS_API_KEY}"
      }
    },
    {
      "module": "@commons/hallucinator/deepgram",
      "secrets": {
        "key": "${SECRET_VIVA_DEEPGRAM_API_KEY}"
      }
    }
  ],
  "clients": [
    {
      "manifest": {
        "type": "client",
        "slug": "ghost"
      }
    },
    {
      "manifest": {
        "type": "client",
        "slug": "anima",
        "traits": [
          "ATTACHED"
        ]
      },
      "statics": {
        "serve": "${VIVA_CLIENT_ANIMA_SERVE}"
      }
    }
  ],
  "services": [
    {
      "manifest": {
        "type": "service",
        "slug": "nlp-stanza"
      },
      "module": "@commons/service/nlp-stanza",
      "secrets": {
        "key": "${SECRET_VIVA_SERVICE_NLP_KEY}"
      },
      "statics": {
        "serve": "${VIVA_SERVICE_NLP_SERVE}",
        "processors": "tokenize,mwt,pos,lemma,depparse"
      }
    }
  ],
  "daemons": [
    {
      "manifest": {
        "type": "daemon",
        "slug": "spanish",
        "version": "0.0.1",
        "name": "Español",
        "description": "English → Spanish. Aprende is the homepage; dojo, nyan and riddler are live.",
        "icon": {
          "emoji": "🇪🇸"
        }
      },
      "statics": {
        "language": {
          "known": {
            "slug": "english",
            "name": "English"
          },
          "learning": {
            "slug": "spanish",
            "name": "Español"
          }
        }
      },
      "modes": [
        "@education/domain/language-learning",
        "@education/topology/word",
        "@education/topology/sentence",
        "@education/topology/conjugation",
        "@education/topography/english-to-spanish",
        "@education/homepage/aprende",
        "@commons/dashboard/dataspace",
        "@education/game/dojo",
        "@education/game/nyan",
        "@education/game/riddler",
        "@education/game/comando",
        "@education/game/cocina"
      ],
      "consume": {
        "nlp": {
          "module": "@commons/service/nlp-stanza",
          "secrets": {
            "key": "${SECRET_VIVA_SERVICE_NLP_KEY}"
          },
          "statics": {
            "remote": "${VIVA_SERVICE_NLP_REMOTE}",
            "language": "es",
            "processors": "tokenize,mwt,pos,lemma,depparse"
          }
        }
      }
    }
  ],
  "environment": {
    "type": "object",
    "required": [
      "PUBLIC_VIVA_CLIENT_ANIMA_REMOTE",
      "VIVA_SERVICE_NLP_PORT",
      "VIVA_SERVICE_NLP_SERVE",
      "VIVA_SERVICE_NLP_REMOTE"
    ],
    "properties": {
      "PUBLIC_VIVA_CLIENT_ANIMA_REMOTE": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9+.\\-]*://(?:(?:[A-Za-z0-9\\-._~!$&'()*+,;=:]|%[0-9A-Fa-f]{2})*@)?(?:\\[(?:[0-9A-Fa-f:.]+|v[0-9A-Fa-f]+\\.[A-Za-z0-9\\-._~!$&'()*+,;=:]+)\\]|(?:[A-Za-z0-9\\-._~!$&'()*+,;=]|%[0-9A-Fa-f]{2})*)(?::[0-9]*)?(?:/(?:[A-Za-z0-9\\-._~!$&'()*+,;=:@]|%[0-9A-Fa-f]{2})*)*(?:\\?(?:(?:[A-Za-z0-9\\-._~!$&'()*+,;=:@]|%[0-9A-Fa-f]{2})|[/?])*)?(?:#(?:(?:[A-Za-z0-9\\-._~!$&'()*+,;=:@]|%[0-9A-Fa-f]{2})|[/?])*)?$",
        "title": "RFC 3986 URI with an authority (scheme://…)",
        "description": "The client's own public address, for links it prints about itself.",
        "default": "${VIVA_CLIENT_ANIMA_SERVE}",
        "group": "addresses"
      },
      "VIVA_SERVICE_NLP_PORT": {
        "type": "integer",
        "description": "Port the stanza NLP container binds.",
        "default": "5555",
        "group": "services"
      },
      "VIVA_SERVICE_NLP_SERVE": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9+.\\-]*://(?:(?:[A-Za-z0-9\\-._~!$&'()*+,;=:]|%[0-9A-Fa-f]{2})*@)?(?:\\[(?:[0-9A-Fa-f:.]+|v[0-9A-Fa-f]+\\.[A-Za-z0-9\\-._~!$&'()*+,;=:]+)\\]|(?:[A-Za-z0-9\\-._~!$&'()*+,;=]|%[0-9A-Fa-f]{2})*)(?::[0-9]*)?(?:/(?:[A-Za-z0-9\\-._~!$&'()*+,;=:@]|%[0-9A-Fa-f]{2})*)*(?:\\?(?:(?:[A-Za-z0-9\\-._~!$&'()*+,;=:@]|%[0-9A-Fa-f]{2})|[/?])*)?(?:#(?:(?:[A-Za-z0-9\\-._~!$&'()*+,;=:@]|%[0-9A-Fa-f]{2})|[/?])*)?$",
        "title": "RFC 3986 URI with an authority (scheme://…)",
        "description": "Where the stanza NLP service binds when this instance hosts it.",
        "default": "http://0.0.0.0:${VIVA_SERVICE_NLP_PORT}",
        "group": "services"
      },
      "VIVA_SERVICE_NLP_REMOTE": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9+.\\-]*://(?:(?:[A-Za-z0-9\\-._~!$&'()*+,;=:]|%[0-9A-Fa-f]{2})*@)?(?:\\[(?:[0-9A-Fa-f:.]+|v[0-9A-Fa-f]+\\.[A-Za-z0-9\\-._~!$&'()*+,;=:]+)\\]|(?:[A-Za-z0-9\\-._~!$&'()*+,;=]|%[0-9A-Fa-f]{2})*)(?::[0-9]*)?(?:/(?:[A-Za-z0-9\\-._~!$&'()*+,;=:@]|%[0-9A-Fa-f]{2})*)*(?:\\?(?:(?:[A-Za-z0-9\\-._~!$&'()*+,;=:@]|%[0-9A-Fa-f]{2})|[/?])*)?(?:#(?:(?:[A-Za-z0-9\\-._~!$&'()*+,;=:@]|%[0-9A-Fa-f]{2})|[/?])*)?$",
        "title": "RFC 3986 URI with an authority (scheme://…)",
        "description": "Where the daemon reaches the NLP service. Required — there is no fallback.",
        "default": "http://localhost:${VIVA_SERVICE_NLP_PORT}",
        "group": "services"
      },
      "SECRET_VIVA_SERVICE_NLP_KEY": {
        "type": "string",
        "description": "Shared secret between the runtime and the stanza NLP service.",
        "group": "keys"
      }
    },
    "additionalProperties": false
  }
}
